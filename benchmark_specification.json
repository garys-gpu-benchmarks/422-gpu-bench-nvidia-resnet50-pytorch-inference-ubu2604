    "field_name": "run_benchmark Command Plus Options for Smoke Run (One minute or less)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --dtype bf16 --image-size 64 --batch-size 1,2 --warmup-iters 1 --num-iterations 3 --use-channels-last true"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run (3 to 5 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --dtype bf16 --image-size 224 --batch-size 1,2,4,8,16,32 --warmup-iters 5 --num-iterations 4420 --use-channels-last true"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run (8 to 15 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
